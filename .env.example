# Servidor HTTP
PORT=3000
HOST=0.0.0.0

# Integrações externas
UPSTREAM_TIMEOUT_MS=12000
DANCRF_BASE_URL=https://liturgia.up.railway.app/v2
CANCAONOVA_URL=https://api-liturgia-diaria.vercel.app/cn
SAINT_OF_DAY_URL=https://api-liturgia-diaria.vercel.app/santo-do-dia
WIKIMEDIA_API_URL=https://commons.wikimedia.org/w/api.php
WIKIPEDIA_SUMMARY_BASE_URL=https://pt.wikipedia.org/api/rest_v1/page/summary
IMAGE_LOOKUP_TIMEOUT_MS=9000

# Cache e CORS
CACHE_TTL_SECONDS=21600
CACHE_MAX_ENTRIES=512
CORS_ORIGIN=*

# Síntese de áudio (opcional; requer Piper, modelo ONNX e FFmpeg/FFprobe)
PIPER_BIN=piper
PIPER_MODEL_PATH=./models/pt_BR-faber-medium.onnx
PIPER_CONFIG_PATH=./models/pt_BR-faber-medium.onnx.json
PIPER_VOICE=faber
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
AUDIO_OUTPUT_DIR=./var/audio
AUDIO_SAMPLE_RATE=22050
AUDIO_PAUSE_MS=350
AUDIO_SEGMENT_MAX_CHARS=240
AUDIO_MAX_CHARACTERS=20000
AUDIO_SYNTHESIS_TIMEOUT_MS=600000
